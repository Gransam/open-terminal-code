#!/usr/bin/env python3
"""Save a screenshot with the Chromium already bundled in Open Terminal.

Usage: capture-web https://www.google.fr screenshots/google.png
       capture-web https://www.google.fr screenshots/google.png --width 1280 --height 800
"""
import argparse
import sys
from pathlib import Path

from playwright.sync_api import sync_playwright

def main():
    parser = argparse.ArgumentParser(description="Capture web pages using system Chromium; no browser download.")
    parser.add_argument("url", help="Web URL (http:// or https://)")
    parser.add_argument("output", help="PNG/JPEG output path")
    parser.add_argument("--width", type=int, default=1280)
    parser.add_argument("--height", type=int, default=800)
    parser.add_argument("--timeout", type=int, default=30000, help="Navigation timeout in milliseconds")
    args = parser.parse_args()
    if not args.url.startswith(("http://", "https://")):
        parser.error("URL must begin with http:// or https://")
    if args.width < 1 or args.height < 1:
        parser.error("Viewport dimensions must be positive")
    output = Path(args.output).expanduser().resolve()
    output.parent.mkdir(parents=True, exist_ok=True)
    try:
        with sync_playwright() as p:
            browser = p.chromium.launch(
                executable_path="/usr/bin/chromium",
                headless=True,
                args=["--no-sandbox"],
            )
            try:
                page = browser.new_page(viewport={"width": args.width, "height": args.height})
                page.goto(args.url, wait_until="domcontentloaded", timeout=args.timeout)
                page.screenshot(path=str(output), full_page=False)
                print(str(output))
            finally:
                browser.close()
    except Exception as exc:
        print(f"Screenshot failed: {exc}", file=sys.stderr)
        return 1
    return 0

if __name__ == "__main__":
    sys.exit(main())
