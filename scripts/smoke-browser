#!/usr/bin/env python3
"""Smoke-test Python and Node Playwright against preinstalled system Chromium."""

import os
import subprocess

from playwright.sync_api import sync_playwright

CHROMIUM = "/usr/bin/chromium"
ARGS = ["--no-sandbox", "--disable-dev-shm-usage"]

with sync_playwright() as playwright:
    browser = playwright.chromium.launch(
        executable_path=CHROMIUM, headless=True, args=ARGS
    )
    try:
        page = browser.new_page()
        page.goto("data:text/html,<h1>smoke-test</h1>")
        assert page.locator("h1").inner_text() == "smoke-test"
    finally:
        browser.close()
print("Python Playwright + system Chromium: OK", flush=True)

node_program = """
const { chromium } = require('playwright');
(async () => {
  const browser = await chromium.launch({
    executablePath: '/usr/bin/chromium',
    headless: true,
    args: ['--no-sandbox', '--disable-dev-shm-usage']
  });
  try {
    const page = await browser.newPage();
    await page.goto('data:text/html,<h1>smoke-test</h1>');
    if (await page.locator('h1').innerText() !== 'smoke-test')
      throw new Error('Unexpected browser content');
  } finally {
    await browser.close();
  }
  console.log('Node Playwright + system Chromium: OK');
})().catch(error => {
  console.error(error);
  process.exit(1);
});
"""
node_root = subprocess.check_output(["npm", "root", "-g"], text=True).strip()
environment = os.environ.copy()
environment["NODE_PATH"] = node_root
subprocess.run(["node", "-e", node_program], env=environment, check=True)
