#!/usr/bin/env python3
"""Validate default Python/Node Playwright launches as an unprivileged user.

Uses installed browser revisions from PLAYWRIGHT_BROWSERS_PATH, with no network access.
"""

import os
import subprocess

from playwright.sync_api import sync_playwright

assert os.environ.get("PLAYWRIGHT_BROWSERS_PATH") == "/opt/playwright-browsers"

with sync_playwright() as playwright:
    browser = playwright.chromium.launch(headless=True)
    try:
        page = browser.new_page()
        page.goto("data:text/html,<h1>smoke-test</h1>")
        assert page.locator("h1").inner_text() == "smoke-test"
    finally:
        browser.close()
print("Python Playwright default Chromium launch: OK", flush=True)

node_program = """
const { chromium } = require('playwright');
(async () => {
  const browser = await chromium.launch({ headless: true });
  try {
    const page = await browser.newPage();
    await page.goto('data:text/html,<h1>smoke-test</h1>');
    if (await page.locator('h1').innerText() !== 'smoke-test')
      throw new Error('Unexpected browser content');
  } finally {
    await browser.close();
  }
  console.log('Node Playwright default Chromium launch: OK');
})().catch(error => {
  console.error(error);
  process.exit(1);
});
"""
node_root = subprocess.check_output(["npm", "root", "-g"], text=True).strip()
environment = os.environ.copy()
environment["NODE_PATH"] = node_root
subprocess.run(["node", "-e", node_program], env=environment, check=True)
